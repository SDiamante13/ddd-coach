OPENROUTER_API_KEY=
# Use an OpenRouter model ID in provider/model format.
OPENROUTER_MODEL=
# Required: at least 32 characters, used to sign coach replies. Use a different value in production. Generate one with:
# node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
COACH_SIGNING_KEY=
# Optional: server deadline for a coach reply in milliseconds. Defaults to 25000.
# COACH_TIMEOUT_MS=
# Optional: reasoning effort for reasoning models (none, minimal, low, medium, high, xhigh, max).
# Reasoning tokens count toward the 600-token reply cap. Unset sends no reasoning setting.
# OPENROUTER_REASONING_EFFORT=
